# Copy this file to .env and fill in your keys
# cp .env.example .env

# ── LLM Provider ──────────────────────────────────────
# Set to "gemini" or "groq"
LLM_PROVIDER=gemini

# ── Google Gemini ──────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── Groq (fallback) ────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
